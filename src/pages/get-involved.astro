---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Get Involved — ScandAfriq"
  description="Support ScandAfriq's mission — whether you're a funder, university partner, or mobility/energy industry expert."
>

  <section class="section-padding bg-sand">
    <div class="content-wrapper">
      <h1 class="font-heading font-bold text-3xl md:text-4xl text-ink mb-6 text-center reveal">
        Get Involved
      </h1>
      <p class="text-grey-600 text-center max-w-2xl mx-auto reveal">
        ScandAfriq is actively seeking partners to bring solar-powered e-scooter
        sharing to Nigerian university campuses. Here's how different stakeholders
        can be part of this.
      </p>
    </div>
  </section>

  <section class="px-6 py-12 md:px-8 md:py-16 bg-surface">
    <div class="content-wrapper max-w-3xl space-y-10 reveal-stagger">

      <!-- Block 1: Funders -->
      <article class="bg-surface rounded-xl border border-grey-200 border-l-4 border-l-accent p-8 card-hover reveal">
        <h2 class="font-heading font-bold text-xl text-ink mb-4 flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          Funders &amp; Grant Bodies
        </h2>
        <p class="text-ink/80 leading-relaxed mb-4">
          We're seeking seed funding for pilot hardware — an initial e-scooter fleet —
          and solar charging infrastructure for our first campus deployment. We commit
          to transparent impact reporting, including an annual impact report with
          ridership, emissions, cost savings, and employment data, so funders can track
          exactly what their support achieves.
        </p>
        <a href="/contact/" class="btn-primary">Talk to us about funding</a>
      </article>

      <!-- Block 2: University partners -->
      <article class="bg-surface rounded-xl border border-grey-200 border-l-4 border-l-primary p-8 card-hover reveal">
        <h2 class="font-heading font-bold text-xl text-ink mb-4 flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </span>
          University Partners
        </h2>
        <p class="text-ink/80 leading-relaxed mb-4">
          We're inviting forward-thinking Nigerian universities to pilot e-scooter
          sharing on campus. Your institution provides campus access, space for
          charging stations, and official endorsement — we provide the fleet, the app,
          the local ops team, and all maintenance.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/contact/" class="btn-primary">Propose a campus pilot</a>
          <a href="/how-it-works/" class="text-accent font-medium hover:underline transition-colors">
            See the partnership model →
          </a>
        </div>
      </article>

      <!-- Block 3: Mobility/energy partners -->
      <article class="bg-surface rounded-xl border border-grey-200 border-l-4 border-l-accent p-8 card-hover reveal">
        <h2 class="font-heading font-bold text-xl text-ink mb-4 flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </span>
          Mobility, Energy &amp; Mentorship Partners
        </h2>
        <p class="text-ink/80 leading-relaxed mb-4">
          We're looking to connect with solar and energy companies for charging
          infrastructure, telecom providers for IoT connectivity, accelerators and
          incubators in both Malmö and Lagos, and experienced operators in
          micromobility or fleet management who can advise on scaling.
        </p>
        <a href="/contact/" class="btn-primary">Reach out to partner</a>
      </article>

    </div>
  </section>

  <CtaBand
    heading="We're looking for pilot universities, funders, and mobility partners."
    ctaLabel="Contact us"
    ctaHref="/contact/"
  />

</BaseLayout>
