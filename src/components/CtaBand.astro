---
interface Props {
  heading: string;
  ctaLabel: string;
  ctaHref: string;
}

const { heading, ctaLabel, ctaHref } = Astro.props;
---

<section class="bg-gradient-primary relative overflow-hidden" aria-label="Call to action">
  <div class="absolute inset-0 bg-dots-pattern opacity-30" aria-hidden="true"></div>
  <div class="content-wrapper px-6 py-16 md:px-8 md:py-20 text-center relative z-10">
    <p class="font-heading font-bold text-xl md:text-2xl text-white mb-8 max-w-2xl mx-auto">
      {heading}
    </p>
    <a
      href={ctaHref}
      class="btn-primary-light"
    >
      {ctaLabel}
    </a>
  </div>
</section>
