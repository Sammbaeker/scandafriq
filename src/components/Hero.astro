---
interface Props {
  headline: string;
  subhead: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  statusLine?: string;
}

const { headline, subhead, primaryCta, secondaryCta, statusLine } = Astro.props;
---

<section class="bg-sand">
  <div class="content-wrapper px-6 py-section md:px-8 lg:py-section-lg">
    <div class="max-w-3xl">
      <h1 class="font-heading font-bold text-3xl md:text-4xl text-ink mb-6">
        {headline}
      </h1>
      <p class="text-lg md:text-xl text-ink/80 mb-8 max-w-2xl leading-relaxed">
        {subhead}
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href={primaryCta.href} class="btn-primary">
          {primaryCta.label}
        </a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn-secondary">
            {secondaryCta.label}
          </a>
        )}
      </div>
      {statusLine && (
        <p class="text-sm text-grey-600 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
          {statusLine}
        </p>
      )}
    </div>
  </div>
</section>
